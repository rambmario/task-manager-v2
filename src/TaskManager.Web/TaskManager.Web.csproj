<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-TaskManager_Web-79078508-af3d-472b-a49b-4df86782e6ae</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Precompressed static assets can serve empty CSS under gzip in Debug. -->
    <DisableStaticWebAssetsCompression>true</DisableStaticWebAssetsCompression>
    <EnableStaticWebAssetCompressionInDevelopment>false</EnableStaticWebAssetCompressionInDevelopment>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskManager.App\TaskManager.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <!-- Serve scoped CSS via /app.styles.css without the fingerprinted gzip pipeline. -->
  <Target Name="CopyScopedCssToWwwroot" AfterTargets="BundleScopedCssFiles">
    <Copy SourceFiles="$(IntermediateOutputPath)scopedcss\bundle\$(MSBuildProjectName).styles.css"
          DestinationFiles="$(MSBuildProjectDirectory)\wwwroot\app.styles.css"
          SkipUnchangedFiles="true"
          Condition="Exists('$(IntermediateOutputPath)scopedcss\bundle\$(MSBuildProjectName).styles.css')" />
  </Target>

</Project>
